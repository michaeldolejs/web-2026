---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import ProjectRow from "../components/ProjectRow.astro";
import projects from "../data/unselected.json";

// Secret page: not linked anywhere and kept out of search engines (noindex).
---
<Base title="Unselected" description="Unused and unselected projects." noindex>
  <PageHead label="Projects" />

  <section class="intro">
    <h1 class="intro__text">
      Woah, you found it!
      <span class="intro__break">This a secret webpage with some projects that was I've worked on but they ended up unused or unselected.</span>
      <span class="intro__break">This is really just for me so I have all of these projects at one place, so enjoy, but please don't tell anyone!</span>
    </h1>
  </section>

  <section class="section finished">
    <ul class="project-list">
      {projects.map((project) => <ProjectRow {...project} />)}
    </ul>
  </section>
</Base>
