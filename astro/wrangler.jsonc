// Cloudflare Workers config: static site only, no server code.
// Cloudflare builds on every push to main (Workers Builds): `npm run build`, then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-2026",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Matches Astro's trailingSlash: "never" (/about, not /about/).
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
